// =============================================================================
// SAFE ZONE INTERACTION
// =============================================================================
function EnterSafeZone(safeZoneName : String, pointsAwarded : int) {
    isSafe = true;

    Debug.Log("PlayerCharacter: " + characterName + " found safety in " + safeZoneName + "!");
    Debug.Log("PlayerCharacter: She feels peace washing over her... (+" + pointsAwarded + " points)");

    // Award points through game progress system
    if (gameProgress != null) {
        gameProgress.AddPoints(pointsAwarded, "Found safety: " + safeZoneName);
    }
}

function ExitSafeZone(safeZoneName : String) {
    isSafe = false;

    Debug.Log("PlayerCharacter: " + characterName + " leaves " + safeZoneName + " to continue her journey...");
}

// =============================================================================
// HOPE LOST - GAME OVER
// =============================================================================
function OnHopeLost() {
    if (isDead) return; // Prevent multiple calls
    isDead = true;

    Debug.Log("PlayerCharacter: " + characterName + "'s hope has faded completely...");
    Debug.Log("PlayerCharacter: She survived for " + timeSurvived.ToString("F1") + " seconds before losing hope.");

    // Record death in game progress
    if (gameProgress != null) {
        gameProgress.RecordDeath();
    }

    // Disable movement
    currentSpeed = 0;
    moveDirection = Vector3.zero;

    // TODO: Play defeat animation/sound
    // TODO: Show game over screen

    // Restart level after delay
    Invoke("RestartJourney", 3.0);
}

function RestartJourney() {
    Debug.Log("PlayerCharacter: " + characterName + " gathers her courage to try again...");
    Application.LoadLevel(Application.loadedLevel);
}

// =============================================================================
// PUBLIC HELPER FUNCTIONS
// =============================================================================
function GetHopePercentage() : float {
    return (currentHope / maxHope) * 100.0;
}

function GetTimeSurvived() : float {
    return timeSurvived;
}

function IsSafe() : boolean {
    return isSafe;
}

// =============================================================================
// DEBUG VISUALIZATION
// =============================================================================
function OnDrawGizmos() {
    // Draw fear detection radius
    Gizmos.color = new Color(1, 0.5, 0, 0.2);
    Gizmos.DrawWireSphere(transform.position, fearDistance);

    // Draw hope indicator
    var hopePercent = currentHope / maxHope;
    if (hopePercent > 0.6) {
        Gizmos.color = Color.green;
    } else if (hopePercent > 0.3) {
        Gizmos.color = Color.yellow;
    } else {
        Gizmos.color = Color.red;
    }
    Gizmos.DrawSphere(transform.position + Vector3.up * 2, 0.3);
}

function OnGUI() {
    // Simple HUD
    var hudStyle = new GUIStyle();
    hudStyle.fontSize = 16;
    hudStyle.normal.textColor = Color.white;

    // Hope display
    var hopePercent = GetHopePercentage();
    var hopeColor = Color.green;
    if (hopePercent < 30) hopeColor = Color.red;
    else if (hopePercent < 60) hopeColor = Color.yellow;

    GUI.color = hopeColor;
    GUI.Label(new Rect(10, 10, 300, 30), characterName + "'s Hope: " + hopePercent.ToString("F1") + "%", hudStyle);

    // Status display
    GUI.color = Color.white;
    var status = isSafe ? "SAFE - Finding Peace" : (isAfraid ? "DANGER - Running!" : "Exploring");
    GUI.Label(new Rect(10, 35, 300, 30), "Status: " + status, hudStyle);

    // Score display
    if (gameProgress != null) {
        GUI.Label(new Rect(10, 60, 300, 30), "Points: " + gameProgress.GetTotalPoints(), hudStyle);
    }
}
